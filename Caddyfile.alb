:8088 {
	request_body {
		max_size 12MB
	}
	# Trusted-proxy skipping would let a client inside the ALB subnets forge an address, so take
	# only the entry the ALB appended, and only when the ALB itself is the peer.
	@alb {
		remote_ip {$TRUSTED_PROXY_CIDRS}
		header_regexp alb X-Forwarded-For ^(?:.*,)?\s*((?:[0-9]{1,3}\.){3}[0-9]{1,3})\s*$
	}
	vars client_address {remote_host}
	vars @alb client_address {re.alb.1}
	@ingest path /v1/events /v1/events/*
	handle @ingest {
		reverse_proxy ingest:8080 {
			header_up -CF-Connecting-IP
			header_up X-Forwarded-For {vars.client_address}
			header_up X-Real-IP {vars.client_address}
			header_up X-Forwarded-Host {hostport}
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		reverse_proxy web:3000 {
			header_up -CF-Connecting-IP
			header_up X-Forwarded-For {vars.client_address}
			header_up X-Real-IP {vars.client_address}
			header_up X-Forwarded-Host {hostport}
			header_up X-Forwarded-Proto https
		}
	}
}
